{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "trading-copilot-internal-local",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": { "COLLECTION_MODE": "local-internal" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "journey-internal-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
